# Copie este arquivo para "local.properties" (na mesma pasta) e preencha com seus dados.
# O local.properties está no .gitignore e não vai para o GitHub.

# Usuário e senha do seu MySQL
spring.datasource.username=root
spring.datasource.password=SUA_SENHA

# Chave secreta do JWT: qualquer texto aleatório com pelo menos 32 caracteres.
# Para gerar uma (PowerShell):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# (Linux/Mac: openssl rand -base64 48)
taskflow.jwt.secret=TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES
